# Proxy de producción (servidor AWS). Lo usa docker-compose.prod.yml.
# {$DOMINIO} viene del .env de la raíz. Caddy pide y renueva solo los certificados HTTPS
# y pasa al backend la IP real del usuario (X-Forwarded-For). Los WebSocket del chat funcionan sin configuración extra.

(seguridad) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# App (Angular)
{$DOMINIO} {
	import seguridad
	reverse_proxy frontend:8080
}

# API (FastAPI) + chat wss:// + /uploads
api.{$DOMINIO} {
	import seguridad
	# Hasta 10 documentos de 10 MB por petición (validador_documento.py) + margen
	request_body {
		max_size 110MB
	}
	reverse_proxy backend:8000
}

# Grafana (tiene su propio login)
grafana.{$DOMINIO} {
	import seguridad
	reverse_proxy grafana:3000
}
