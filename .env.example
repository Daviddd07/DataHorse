# Plantilla del .env de la RAÍZ (lo leen docker-compose.yml y docker-compose.prod.yml).
# Copiar a .env y llenar los valores. El .env real NUNCA se sube a git (está en .gitignore).
# En producción usar valores NUEVOS, distintos a los de desarrollo.

# --- Base de datos (MySQL) ---
# Contraseña del usuario root de MySQL. Larga y aleatoria (ej.: openssl rand -base64 32)
DB_ROOT_PASSWORD=
# Nombre de la base de datos (debe coincidir con DB_NAME de backend/.env)
DB_NAME=
# Contraseña del usuario de MySQL de solo lectura que usa Grafana (init-db/03_grafana_lector.sh).
# Solo letras y números (ej.: openssl rand -hex 24). Se aplica al crear la base por primera vez.
GRAFANA_DB_PASSWORD=

# --- Solo producción (docker-compose.prod.yml) ---
# Dominio de la app, sin https:// (ej.: midominio.com). La API queda en api.DOMINIO y Grafana en grafana.DOMINIO
DOMINIO=
